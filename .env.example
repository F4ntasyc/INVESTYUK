# --- Docker Compose (MySQL) ---
MYSQL_ROOT_PASSWORD=ganti-dengan-password-sederhana
MYSQL_DATABASE=investyuk

# --- Aplikasi (npm run dev di komputer) ---
# Password di sini harus sama dengan MYSQL_ROOT_PASSWORD (hindari karakter khusus)
DATABASE_URL="mysql://root:ganti-dengan-password-sederhana@localhost:3306/investyuk"
AUTH_SECRET=isi-dengan-string-acak
AUTH_URL=http://localhost:3000
SMTP_HOST=localhost
SMTP_PORT=1025
MAIL_FROM="INVESTYUK <no-reply@investyuk.local>"