# --- Docker Compose (MySQL) ---
MYSQL_ROOT_PASSWORD=
MYSQL_DATABASE=investyuk

# --- Aplikasi (npm run dev di komputer) ---
# Password di sini harus sama dengan MYSQL_ROOT_PASSWORD (hindari karakter khusus)
DATABASE_URL="mysql://root:ganti@localhost:3307/investyuk"
AUTH_SECRET=isi-dengan-string-acak
AUTH_URL=http://localhost:3000
SMTP_HOST=localhost
SMTP_PORT=1025
MAIL_FROM="INVESTYUK <no-reply@investyuk.local>"

# --- Seed data (HANYA untuk lokal) ---
# Password semua akun uji hasil `npm run db:seed`. Jangan dipakai di produksi.
SEED_TEST_PASSWORD=Uji-Investyuk-2026
